@model List<Paciente>
@{
    ViewData["Title"] = "Pacientes";
    var criterio = ViewBag.Criterio as string;
    var pagina = (int)ViewBag.Pagina;
    var totalPaginas = (int)ViewBag.TotalPaginas;
    var total = (int)ViewBag.Total;
    var criterioInvalido = ViewBag.CriterioInvalido is true;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Pacientes</h1>
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(criterio)
                ? $"{total} paciente(s) registrado(s)"
                : $"{total} paciente(s) coinciden con la búsqueda")
        </p>
    </div>
    <a class="btn btn-principal" asp-action="Crear">Registrar paciente</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Listado" method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="criterioListado">Buscar por carnet, nombre o apellido</label>
                <input id="criterioListado" name="criterio" value="@criterio" class="form-control"
                       maxlength="80" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-principal w-100">Buscar</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table tabla-compacta mb-0 align-middle">
            <thead>
            <tr>
                <th>Carnet</th>
                <th>Paciente</th>
                <th class="numero">Edad</th>
                <th>Sexo</th>
                <th>Teléfono</th>
                <th>Registrado</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        @(criterioInvalido
                            ? "La búsqueda no contiene letras ni números que se puedan buscar."
                            : "No hay pacientes que coincidan con la búsqueda.")
                    </td>
                </tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold">@p.DocumentoCompleto</td>
                    <td>
                        <a asp-action="Ficha" asp-route-id="@p.IdPaciente">@p.NombreCompleto</a>
                    </td>
                    <td class="numero">@p.Edad</td>
                    <td>@p.Sexo?.Descripcion</td>
                    <td>@(p.Telefono ?? "—")</td>
                    <td>@p.FechaRegistro.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-principal"
                           asp-controller="Atenciones" asp-action="Crear"
                           asp-route-idPaciente="@p.IdPaciente">Nueva entrega</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (totalPaginas > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (var i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Listado"
                       asp-route-criterio="@criterio" asp-route-pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

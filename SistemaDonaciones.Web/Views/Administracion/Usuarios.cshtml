@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">Usuarios del sistema</h1>
    <a class="btn btn-principal" asp-action="UsuarioForm">Nuevo usuario</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table tabla-compacta mb-0 align-middle">
            <thead>
            <tr>
                <th>Usuario</th>
                <th>Nombre completo</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Último acceso</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold">@u.NombreUsuario</td>
                    <td>@u.NombreCompleto</td>
                    <td class="small">@(u.Email ?? "—")</td>
                    <td>@u.Rol?.Nombre</td>
                    <td>
                        @if (u.Activo)
                        {
                            <span class="badge insignia-fifo">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="small">
                        @(u.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-principal"
                           asp-action="UsuarioForm" asp-route-id="@u.IdUsuario">Editar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

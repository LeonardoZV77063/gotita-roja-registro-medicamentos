@model IngresoLoteViewModel
@{
    ViewData["Title"] = "Registrar ingreso";
    var hoyIso = DateTime.Today.ToString("yyyy-MM-dd");
    var ingresoMinimoIso = ServicioFarmacia.IngresoMinimo.ToString("yyyy-MM-dd");
}

<div class="mb-4">
    <h1 class="h3 mb-1">Registrar ingreso de medicamento</h1>
    <p class="text-muted mb-0">
        Cada ingreso guarda su propio precio. Cuando se done, el sistema tomará
        primero las unidades más antiguas con el precio que tenían entonces, en
        lugar de promediar.
    </p>
</div>

<div class="card" style="max-width: 46rem;">
    <div class="card-body">
        <form asp-action="Ingresar" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Medicamento" class="form-label obligatorio"></label>
                    <input asp-for="Medicamento" class="form-control"
                           data-autocompletar="@Url.Action("SugerirMedicamentos", "Atenciones")"
                           autocomplete="off" data-foco-inicial />
                    <div class="ayuda-campo">
                        Escriba el nombre tal como venga. Si es nuevo, se crea solo.
                    </div>
                    <span asp-validation-for="Medicamento" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IdUnidadMedida" class="form-label"></label>
                    <select asp-for="IdUnidadMedida" class="form-select">
                        <option value="">— Sin especificar —</option>
                        @foreach (var u in Model.UnidadesMedida)
                        {
                            <option value="@u.IdUnidadMedida">@u.Descripcion</option>
                        }
                    </select>
                    <span asp-validation-for="IdUnidadMedida" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IdTipoIngreso" class="form-label obligatorio"></label>
                    <select asp-for="IdTipoIngreso" class="form-select">
                        <option value="">— Seleccione —</option>
                        @foreach (var t in Model.TiposIngreso)
                        {
                            <option value="@t.IdTipoIngreso">@t.Descripcion</option>
                        }
                    </select>
                    <span asp-validation-for="IdTipoIngreso" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CantidadIngresada" class="form-label obligatorio"></label>
                    <input asp-for="CantidadIngresada" type="number" step="0.01" min="0.01"
                           class="form-control" />
                    <span asp-validation-for="CantidadIngresada" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CostoUnitario" class="form-label obligatorio"></label>
                    <input asp-for="CostoUnitario" type="number" step="0.01" min="0"
                           class="form-control" />
                    <div class="ayuda-campo">
                        Precio de compra, o valor estimado si es donación.
                    </div>
                    <span asp-validation-for="CostoUnitario" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaIngreso" class="form-label obligatorio"></label>
                    <input asp-for="FechaIngreso" type="date" class="form-control"
                           min="@ingresoMinimoIso" max="@hoyIso" />
                    <div class="ayuda-campo">No puede ser posterior a hoy.</div>
                    <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaVencimiento" class="form-label"></label>
                    <input asp-for="FechaVencimiento" type="date" class="form-control"
                           data-fecha-posterior-a="#FechaIngreso" />
                    <span asp-validation-for="FechaVencimiento" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="NumeroLote" class="form-label"></label>
                    <input asp-for="NumeroLote" class="form-control" maxlength="40" />
                </div>

                <div class="col-md-8">
                    <label asp-for="Origen" class="form-label"></label>
                    <input asp-for="Origen" class="form-control" maxlength="120"
                           placeholder="Farmacia, empresa donante, particular…" />
                </div>

                <div class="col-md-4">
                    <label asp-for="NumeroFactura" class="form-label"></label>
                    <input asp-for="NumeroFactura" class="form-control" maxlength="40" />
                </div>
            </div>

            <hr class="my-4" />

            <button type="submit" class="btn btn-principal">Registrar ingreso</button>
            <a class="btn btn-link" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

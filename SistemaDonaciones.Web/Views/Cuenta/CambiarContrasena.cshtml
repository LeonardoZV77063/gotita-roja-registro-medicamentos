@model CambiarContrasenaViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="card" style="max-width: 30rem;">
    <h1 class="card-header h5 mb-0">Cambiar contraseña</h1>
    <div class="card-body">
        <form asp-action="CambiarContrasena" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="ContrasenaActual" class="form-label obligatorio"></label>
                <input asp-for="ContrasenaActual" class="form-control"
                       autocomplete="current-password" data-foco-inicial />
                <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContrasenaNueva" class="form-label obligatorio"></label>
                <input asp-for="ContrasenaNueva" class="form-control" autocomplete="new-password" />
                <div class="ayuda-campo">Mínimo 8 caracteres.</div>
                <span asp-validation-for="ContrasenaNueva" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ContrasenaConfirmacion" class="form-label obligatorio"></label>
                <input asp-for="ContrasenaConfirmacion" class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="ContrasenaConfirmacion" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-principal">Guardar</button>
            <a class="btn btn-link" asp-controller="Home" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

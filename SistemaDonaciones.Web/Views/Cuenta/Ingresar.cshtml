@model LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    Layout = "_LayoutLimpio";
}

<div class="card shadow-sm" style="max-width: 26rem; margin: 4rem auto;">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Registro de entregas</h1>
        <p class="text-muted small mb-4">
            Pacientes y medicamentos donados
        </p>

        <form asp-action="Ingresar" method="post">
            <input type="hidden" asp-for="UrlRetorno" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label"></label>
                <input asp-for="NombreUsuario" class="form-control" autocomplete="username"
                       data-foco-inicial />
                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Recordarme" class="form-check-input" />
                <label asp-for="Recordarme" class="form-check-label small"></label>
            </div>

            <button type="submit" class="btn btn-principal w-100">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

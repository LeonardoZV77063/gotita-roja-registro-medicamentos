@{
    ViewData["Title"] = "Sin permiso";
    Layout = "_LayoutLimpio";
}

<div class="card shadow-sm" style="max-width: 30rem; margin: 4rem auto;">
    <div class="card-body p-4 text-center">
        <h1 class="h5 mb-3">No tiene permiso para esta sección</h1>
        <p class="text-muted">
            Su cuenta no tiene el rol necesario para acceder a esta parte del sistema.
            Si cree que se trata de un error, comuníquese con el administrador.
        </p>
        <a class="btn btn-principal" asp-controller="Home" asp-action="Index">
            Volver al inicio
        </a>
    </div>
</div>

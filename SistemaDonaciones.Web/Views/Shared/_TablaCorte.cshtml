@model List<FilaReporteEstadistico>
@* Cada corte reutiliza el mismo resultado de GROUPING SETS y filtra sus filas. *@

<div class="table-responsive">
    <table class="table tabla-compacta mb-0">
        <thead>
        <tr>
            <th>Categoría</th>
            <th class="numero">Atenciones</th>
            <th class="numero">Monto (Bs)</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var fila in Model)
        {
            <tr>
                <td>@fila.Etiqueta</td>
                <td class="numero">@fila.Atenciones</td>
                <td class="numero">@(fila.MontoDonado?.ToString("N2") ?? "0,00")</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="3" class="text-center text-muted py-3">Sin datos.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
